# Copy this file to .env and fill in real values before running deploy.sh:
#   cp example.env .env

# MySQL root password
MYSQL_ROOT_PASSWORD=change_me_root_password

# WordPress Kupa database credentials (only granted access to `kupa` DB)
KUPA_DB_USER=wp_kupa
KUPA_DB_PASSWORD=change_me_kupa_db_password

# WordPress Personal database credentials (only granted access to `personal` DB)
PERSONAL_DB_USER=wp_personal
PERSONAL_DB_PASSWORD=change_me_personal_db_password

# WordPress admin credentials
WP_ADMIN_USERNAME=admin
WP_ADMIN_PASSWORD=change_me_wp_admin_password
