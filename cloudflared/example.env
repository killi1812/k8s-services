# Copy this file to .env and fill in real values before running deploy.sh:
#   cp example.env .env
#
# One-time setup for a dedicated K3s tunnel with wildcard DNS (*.francvok.from.hr):
#   cloudflared tunnel create k3s-traefik
#   cloudflared tunnel route dns k3s-traefik "*.francvok.from.hr"
# (If kupa/home/atuin already have CNAMEs pointing to pc-dev, delete or overwrite them
#  so they fall through to the * wildcard CNAME; keep ssh/webhook/kuma/etc. on pc-dev.)

# Tunnel UUID from `cloudflared tunnel create k3s-traefik`
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Base64-encoded contents of ~/.cloudflared/<CF_TUNNEL_ID>.json:
#   base64 -w0 ~/.cloudflared/<CF_TUNNEL_ID>.json
CF_CREDENTIALS_JSON_B64=eyJBY2NvdW50VGFnIjoicmVwbGFjZV9tZSIsIlR1bm5lbFNlY3JldCI6InJlcGxhY2VfbWUiLCJUdW5uZWxJRCI6IjAwMDAwMDAwLTAwMDAtMDAwMC0wMDAwLTAwMDAwMDAwMDAwMCJ9
